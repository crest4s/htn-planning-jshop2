(defdomain emergency (

  ;; =========================================================
  ;; OPERADORES PRIMITIVOS
  ;; =========================================================

  ;; Vuelo sin transportador: coste base 50
  (:operator (!vuelo ?d ?orig ?dest)
    ((at ?d ?orig))
    ((at ?d ?orig))
    ((at ?d ?dest))
    50
  )

  ;; Vuelo con transportador: coste 50 + capacidad/10
  (:operator (!vuelo-con-trans ?d ?trans ?orig ?dest)
    ((at ?d ?orig) (tiene-trans ?d ?trans))
    ((at ?d ?orig))
    ((at ?d ?dest))
    (+ 50 (/ (capacidad ?trans) 10))
  )

  ;; Recoger transportador en el depósito
  (:operator (!coger-trans ?d ?trans)
    ((at ?d depot) (at ?trans depot) (libre-trans ?d))
    ((libre-trans ?d))
    ((tiene-trans ?d ?trans))
  )

  ;; Soltar transportador en el depósito
  (:operator (!soltar-trans ?d ?trans)
    ((at ?d depot) (tiene-trans ?d ?trans))
    ((tiene-trans ?d ?trans))
    ((libre-trans ?d))
  )

  ;; Cargar cajas de un tipo en el transportador desde depósito
  ;; ?cant = cantidad que se mete (ya calculada por el método)
  (:operator (!cargar-trans ?d ?trans ?tipo ?cant)
    (
      (at ?d depot)
      (tiene-trans ?d ?trans)
      (assign ?stock-dep (stock depot ?tipo))
      (assign ?carga-act (carga ?trans))
      (assign ?cap (capacidad ?trans))
      (> ?stock-dep 0)
      (> ?cant 0)
      (<= (+ ?carga-act ?cant) ?cap)
      (<= ?cant ?stock-dep)
    )
    ()
    ()
    0
    (
      (stock depot ?tipo) (- (stock depot ?tipo) ?cant)
      (carga ?trans)      (+ (carga ?trans) ?cant)
      (en-trans ?trans ?tipo) (+ (en-trans ?trans ?tipo) ?cant)
    )
  )

  ;; Descargar cajas de un tipo del transportador en una localización
  (:operator (!descargar-trans ?d ?trans ?tipo ?cant ?loc)
    (
      (at ?d ?loc)
      (tiene-trans ?d ?trans)
      (assign ?en (en-trans ?trans ?tipo))
      (assign ?nec (necesita ?loc ?tipo))
      (> ?cant 0)
      (<= ?cant ?en)
      (<= ?cant ?nec)
    )
    ()
    ()
    0
    (
      (en-trans ?trans ?tipo)  (- (en-trans ?trans ?tipo) ?cant)
      (carga ?trans)           (- (carga ?trans) ?cant)
      (necesita ?loc ?tipo)    (- (necesita ?loc ?tipo) ?cant)
    )
  )

  ;; Recoger caja suelta desde depósito (sin transportador, 1 a la vez)
  (:operator (!recoger-suelta ?d ?tipo)
    (
      (at ?d depot)
      (libre-trans ?d)
      (assign ?s (stock depot ?tipo))
      (> ?s 0)
    )
    ()
    ((lleva-suelta ?d ?tipo))
    0
    (
      (stock depot ?tipo) (- (stock depot ?tipo) 1)
    )
  )

  ;; Entregar caja suelta en una localización
  (:operator (!entregar-suelta ?d ?tipo ?loc)
    (
      (at ?d ?loc)
      (lleva-suelta ?d ?tipo)
      (assign ?nec (necesita ?loc ?tipo))
      (> ?nec 0)
    )
    ((lleva-suelta ?d ?tipo))
    ()
    0
    (
      (necesita ?loc ?tipo) (- (necesita ?loc ?tipo) 1)
    )
  )

  ;; =========================================================
  ;; MÉTODOS
  ;; =========================================================

  ;; ---------------------------------------------------------
  ;; TAREA PRINCIPAL: enviar-todo
  ;; ---------------------------------------------------------
  (:method (enviar-todo)

    ;; Caso 1: Hay transportadores disponibles → elegir el mejor y hacer ruta
    hay-transportadores
    (
      (at ?d depot)
      (libre-trans ?d)
      (necesidad-total-positiva)
    )
    ((elegir-y-enviar ?d) (enviar-todo))

    ;; Caso 2: No hay transportadores → llevar cajas sueltas
    solo-sueltas
    (
      (at ?d depot)
      (libre-trans ?d)
      (necesidad-total-positiva)
      (not (hay-trans-en-depot))
    )
    ((enviar-sueltas ?d) (enviar-todo))

    ;; Caso 3: El dron viene de vuelta y tiene que volver al depósito primero
    volver-al-depot
    (
      (at ?d ?loc)
      (not (at ?d depot))
      (necesidad-total-positiva)
    )
    ((ir-a ?d ?loc depot) (enviar-todo))

    ;; Caso base: todo entregado
    terminado
    ()
    ()
  )

  ;; ---------------------------------------------------------
  ;; ELEGIR TRANSPORTADOR Y HACER RUTA COMPLETA
  ;; ---------------------------------------------------------
  (:method (elegir-y-enviar ?d)

    ;; Hay un transportador que cubre o supera la demanda total → elegir el MENOR
    elegir-menor-suficiente
    (
      (at ?d depot)
      (assign ?total-nec (total-necesidades))
      (at ?trans depot)
      (assign ?cap (capacidad ?trans))
      (>= ?cap ?total-nec)
      ;; que no haya otro transportador con capacidad suficiente pero menor
      (not (at ?trans2 depot) (assign ?cap2 (capacidad ?trans2)) (>= ?cap2 ?total-nec) (< ?cap2 ?cap))
    )
    ((usar-trans ?d ?trans))

    ;; Todos los transportadores son menores que la demanda → elegir el MAYOR
    elegir-mayor-insuficiente
    (
      (at ?d depot)
      (at ?trans depot)
      (assign ?cap (capacidad ?trans))
      ;; que no haya otro con mayor capacidad
      (not (at ?trans2 depot) (assign ?cap2 (capacidad ?trans2)) (> ?cap2 ?cap))
    )
    ((usar-trans ?d ?trans))
  )

  ;; ---------------------------------------------------------
  ;; USAR UN TRANSPORTADOR: cargar, hacer ruta multi-parada, volver
  ;; ---------------------------------------------------------
  (:method (usar-trans ?d ?trans)
    uso-trans
    ((at ?d depot))
    (
      (!coger-trans ?d ?trans)
      (cargar-trans-optimo ?d ?trans)
      (ruta-multi-parada ?d ?trans)
      (!soltar-trans ?d ?trans)
      (manejar-sueltas ?d)
    )
  )

  ;; ---------------------------------------------------------
  ;; CARGAR EL TRANSPORTADOR de forma óptima
  ;; Carga comida y medicina según las necesidades de las localizaciones
  ;; ---------------------------------------------------------
  (:method (cargar-trans-optimo ?d ?trans)

    ;; Cargar un tipo mientras queden huecos y haya necesidad y stock
    cargar-tipo
    (
      (at ?d depot)
      (tiene-trans ?d ?trans)
      (tipo-con-necesidad ?tipo)
      (assign ?stock (stock depot ?tipo))
      (> ?stock 0)
      (assign ?espacio (- (capacidad ?trans) (carga ?trans)))
      (> ?espacio 0)
      (assign ?total-nec-tipo (total-necesidad-tipo ?tipo))
      (> ?total-nec-tipo 0)
      (assign ?cant (min ?espacio (min ?stock ?total-nec-tipo)))
      (> ?cant 0)
    )
    ((!cargar-trans ?d ?trans ?tipo ?cant) (cargar-trans-optimo ?d ?trans))

    ;; Terminado: no hay más espacio o no hay más que cargar
    fin-carga
    ()
    ()
  )

  ;; ---------------------------------------------------------
  ;; RUTA MULTI-PARADA: visitar localizaciones por orden de necesidad
  ;; sin volver al depósito si aún lleva carga para más de una
  ;; ---------------------------------------------------------
  (:method (ruta-multi-parada ?d ?trans)

    ;; Hay localización con necesidad y tenemos carga para ella → ir y descargar
    siguiente-parada
    (
      (tiene-trans ?d ?trans)
      (loc-con-necesidad ?loc)
      (tiene-carga-para ?trans ?loc)
      ;; localización con mayor necesidad total (prioridad)
      (assign ?nec-loc (necesidad-loc ?loc))
      (not (loc-con-necesidad ?loc2) (tiene-carga-para ?trans ?loc2) (assign ?nec2 (necesidad-loc ?loc2)) (> ?nec2 ?nec-loc))
      (at ?d ?origen)
    )
    (
      (!vuelo-con-trans ?d ?trans ?origen ?loc)
      (descargar-en ?d ?trans ?loc)
      (ruta-multi-parada ?d ?trans)
    )

    ;; No queda carga útil → volver al depósito
    volver
    ((at ?d ?loc) (not (at ?d depot)) (tiene-trans ?d ?trans))
    ((!vuelo-con-trans ?d ?trans ?loc depot))

    ;; Ya en depósito, fin de ruta
    en-depot
    ((at ?d depot))
    ()
  )

  ;; ---------------------------------------------------------
  ;; DESCARGAR EN UNA LOCALIZACIÓN: vaciar todo lo necesario
  ;; ---------------------------------------------------------
  (:method (descargar-en ?d ?trans ?loc)

    descargar-tipo
    (
      (at ?d ?loc)
      (tiene-trans ?d ?trans)
      (assign ?en-f (en-trans ?trans food))
      (assign ?nec-f (necesita ?loc food))
      (assign ?cant-f (min ?en-f ?nec-f))
      (> ?cant-f 0)
    )
    ((!descargar-trans ?d ?trans food ?cant-f ?loc) (descargar-en ?d ?trans ?loc))

    descargar-medicina
    (
      (at ?d ?loc)
      (tiene-trans ?d ?trans)
      (assign ?en-m (en-trans ?trans medicine))
      (assign ?nec-m (necesita ?loc medicine))
      (assign ?cant-m (min ?en-m ?nec-m))
      (> ?cant-m 0)
    )
    ((!descargar-trans ?d ?trans medicine ?cant-m ?loc) (descargar-en ?d ?trans ?loc))

    fin-descarga
    ()
    ()
  )

  ;; ---------------------------------------------------------
  ;; MANEJAR CAJAS SUELTAS: si tras devolver el transportador
  ;; quedan necesidades, llevarlas una a una
  ;; ---------------------------------------------------------
  (:method (manejar-sueltas ?d)

    llevar-suelta
    (
      (at ?d depot)
      (libre-trans ?d)
      (necesidad-total-positiva)
      (tipo-con-necesidad ?tipo)
      (assign ?s (stock depot ?tipo))
      (> ?s 0)
      (loc-con-necesidad-tipo ?loc ?tipo)
      (at ?d ?orig)
    )
    (
      (!recoger-suelta ?d ?tipo)
      (ir-a ?d ?orig ?loc)
      (!entregar-suelta ?d ?tipo ?loc)
      (ir-a ?d ?loc depot)
      (manejar-sueltas ?d)
    )

    fin-sueltas
    ()
    ()
  )

  ;; ---------------------------------------------------------
  ;; ENVIAR SUELTAS: modo sin transportador desde el inicio
  ;; ---------------------------------------------------------
  (:method (enviar-sueltas ?d)

    entregar-una
    (
      (at ?d depot)
      (libre-trans ?d)
      (necesidad-total-positiva)
      (tipo-con-necesidad ?tipo)
      (assign ?s (stock depot ?tipo))
      (> ?s 0)
      (loc-con-necesidad-tipo ?loc ?tipo)
    )
    (
      (!recoger-suelta ?d ?tipo)
      (ir-a ?d depot ?loc)
      (!entregar-suelta ?d ?tipo ?loc)
      (ir-a ?d ?loc depot)
      (enviar-sueltas ?d)
    )

    fin
    ()
    ()
  )

  ;; ---------------------------------------------------------
  ;; MOVIMIENTO: vuela solo si es necesario
  ;; ---------------------------------------------------------
  (:method (ir-a ?d ?orig ?dest)
    ya-estoy
    ((at ?d ?dest))
    ()

    volar
    ((not (at ?d ?dest)))
    ((!vuelo ?d ?orig ?dest))
  )

  ;; =========================================================
  ;; AXIOMAS (funciones derivadas para usar en precondiciones)
  ;; =========================================================

  ;; ¿Hay alguna necesidad pendiente en cualquier localización?
  (:- (necesidad-total-positiva)
    (
      (loc-con-necesidad ?loc)
    )
  )

  ;; ¿Una localización tiene necesidad de algún tipo?
  (:- (loc-con-necesidad ?loc)
    (
      (assign ?n (necesita ?loc food))
      (> ?n 0)
    )
  )
  (:- (loc-con-necesidad ?loc)
    (
      (assign ?n (necesita ?loc medicine))
      (> ?n 0)
    )
  )

  ;; ¿Una localización tiene necesidad de un tipo concreto?
  (:- (loc-con-necesidad-tipo ?loc ?tipo)
    (
      (assign ?n (necesita ?loc ?tipo))
      (> ?n 0)
    )
  )

  ;; ¿Hay algún tipo con necesidad total > 0?
  (:- (tipo-con-necesidad ?tipo)
    (
      (loc-con-necesidad-tipo ?loc ?tipo)
    )
  )

  ;; ¿El transportador lleva algo útil para esa localización?
  (:- (tiene-carga-para ?trans ?loc)
    (
      (assign ?f (en-trans ?trans food))
      (assign ?nf (necesita ?loc food))
      (> ?f 0)
      (> ?nf 0)
    )
  )
  (:- (tiene-carga-para ?trans ?loc)
    (
      (assign ?m (en-trans ?trans medicine))
      (assign ?nm (necesita ?loc medicine))
      (> ?m 0)
      (> ?nm 0)
    )
  )

  ;; Necesidad total de una localización (food + medicine)
  (:- (necesidad-loc ?loc ?total)
    (
      (assign ?f (necesita ?loc food))
      (assign ?m (necesita ?loc medicine))
      (assign ?total (+ ?f ?m))
    )
  )

  ;; Necesidad total de un tipo en todas las localizaciones
  (:- (total-necesidad-tipo ?tipo ?total)
    ;; Solo puede sumarse iterando; como JSHOP2 no suma sobre varios,
    ;; usamos el máximo de una localización como aproximación para la carga
    (
      (loc-con-necesidad-tipo ?loc ?tipo)
      (assign ?total (necesita ?loc ?tipo))
    )
  )

  ;; Suma de todas las necesidades (aproximación: mayor loc)
  (:- (total-necesidades ?total)
    (
      (loc-con-necesidad ?loc)
      (assign ?f (necesita ?loc food))
      (assign ?m (necesita ?loc medicine))
      (assign ?total (+ ?f ?m))
      (not (loc-con-necesidad ?loc2)
           (assign ?f2 (necesita ?loc2 food))
           (assign ?m2 (necesita ?loc2 medicine))
           (assign ?t2 (+ ?f2 ?m2))
           (> ?t2 ?total))
    )
  )

  ;; ¿Hay algún transportador en el depósito?
  (:- (hay-trans-en-depot)
    ((at ?trans depot) (capacidad ?trans))
  )

))
